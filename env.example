# ==============================================================================
# متغيرات تمام شوب
# تنحط بـ Netlify:  Site configuration ← Environment variables ← Add a variable
# بعد أي تغيير:  Deploys ← Trigger deploy ← Deploy site
# (للتشغيل على جهازك: انسخ هذا الملف باسم .env واملأه)
# ==============================================================================

# ---------------- إلزامي ----------------

# رابط مشروع Supabase  (Project Settings ← API ← Project URL)
SUPABASE_URL=""

# المفتاح السري  (Project Settings ← API Keys ← secret / service_role). لا تشاركه مع أحد
SUPABASE_SERVICE_ROLE_KEY=""

# كلمة سر لوحة التحكم /admin (10 أحرف أو أكثر). تغييرها يسجّل خروج كل الأجهزة
ADMIN_PASSWORD=""

# رابط موقعك النهائي (مثال: https://tamamshop.com أو https://tamam-shop.netlify.app)
APP_URL=""

# ---------------- الشيتات ----------------

# رابط سكربت شيت 1 (Web app ينتهي بـ /exec) — راجع supabase/sheet-apps-script.js
GOOGLE_SHEET_1_URL=""
# رابط سكربت شيت 2
GOOGLE_SHEET_2_URL=""
# أسماء تظهر بلوحة التحكم وتلغرام (اختياري)
SHEET_1_NAME="شيت 1"
SHEET_2_NAME="شيت 2"

# ---------------- تلغرام (اختياري) ----------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------------- واتساب (اختياري) ----------------
# رقم يظهر كزر تواصل بالموقع (مثال: +9647700000000)
WHATSAPP_NUMBER=""

# ---------------- ميتا (اختياري) ----------------
META_PIXEL_ID=""
# لإرسال الأحداث من السيرفر (Conversions API)
META_ACCESS_TOKEN=""
# للتجربة بـ Test Events فقط، اتركه فارغ بالتشغيل الحقيقي
META_TEST_EVENT_CODE=""

# ---------------- تيك توك (اختياري) ----------------
TIKTOK_PIXEL_ID=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_TEST_EVENT_CODE=""

# سعر صرف الدينار مقابل الدولار (للتقارير وقيم البيكسل). الافتراضي 1400
IQD_TO_USD_RATE="1400"

# ---------------- سرعة تحديث الصفحات (اختياري) ----------------
# بدونه: أي تعديل بلوحة التحكم يبين بالموقع خلال دقيقة.
# وياه: التعديل يبين فوراً والصفحات تبقى سريعة جداً.
# تسويه من: Netlify ← User settings ← Applications ← Personal access tokens ← New access token
NETLIFY_PURGE_API_TOKEN=""
# رقم الموقع (Site configuration ← Site details ← Site ID) — مطلوب ويّا التوكن أعلاه
TAMAM_SITE_ID=""
